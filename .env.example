# Required
MONGODB_URI=mongodb://127.0.0.1:27017/philomedia
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_AI_API_KEY=
TMDB_API_KEY=

# Server
PORT=3000
NODE_ENV=development

# Public site / SEO / OAuth callback
PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Google OAuth (optional — login stays disabled without both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS allowlist. Comma-separated. Never use * with cookies.
# Production without this variable disables cross-origin CORS (same-origin only).
CORS_ORIGIN=http://localhost:3000

# Optional TMDB / pairing
TMDB_WATCH_REGION=BR
DAILY_PAIRING_TIME_ZONE=America/Sao_Paulo
GOOGLE_AI_MODEL=

# Test-only. Never enable on a public host.
# ALLOW_TEST_AUTH=1
# TEST_AUTH_USER_JSON={"displayName":"T","watchlist":[]}
