{
  "name": "philomedia",
  "version": "1.0.0",
  "description": "Connect movies and series to philosophical quotes and AI-generated interpretations.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "translate:quotes": "node public/scripts/translate_quotes_wikiquote.js",
    "generate:real-quotes": "node public/scripts/generate-real-quotes.js",
    "generate:real-candidates": "node public/scripts/real-quote-candidates.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/unit tests/integration tests/app.test.js",
    "test:detect": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "lint": "eslint . --ext .js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucassilva027/philomedia.git"
  },
  "keywords": [
    "philosophy",
    "quotes",
    "tmdb",
    "express",
    "gemini"
  ],
  "author": "Lucas Silva",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lucassilva027/philomedia/issues"
  },
  "homepage": "https://github.com/Lucassilva027/philomedia#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "compression": "^1.7.4",
    "connect-mongo": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^6.8.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "mongodb-memory-server": "^8.12.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "forceExit": true,
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^/scripts/(.*)$": "<rootDir>/tests/__mocks__/browserModule.js"
    }
  }
}
