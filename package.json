{
  "name": "philomedia",
  "version": "1.0.0",
  "description": "Connect movies and series to philosophical quotes and AI-generated interpretations.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "translate:quotes": "node scripts/translate_quotes_wikiquote.js",
    "translate:quotes:pt": "node scripts/translate_custom_quotes_pt.js",
    "generate:real-quotes": "node scripts/generate-real-quotes.js",
    "generate:real-candidates": "node scripts/real-quote-candidates.js",
    "seed:quotes": "node scripts/seed-quotes.js",
    "import:wikiquote": "node scripts/import_quotes_wikiquote.js",
    "fonts:download": "node scripts/download-fonts.mjs",
    "benchmark:lenses": "node scripts/benchmark-lenses.mjs",
    "pairings:dedupe": "node scripts/dedupe-daily-pairings.mjs",
    "theme:buckets": "node scripts/theme-buckets.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/unit tests/integration tests/app.test.js",
    "test:e2e": "playwright test",
    "test:detect": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucassilva027/philomedia.git"
  },
  "keywords": [
    "philosophy",
    "quotes",
    "tmdb",
    "express",
    "gemini"
  ],
  "author": "Lucas Silva",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lucassilva027/philomedia/issues"
  },
  "homepage": "https://github.com/Lucassilva027/philomedia#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "compression": "^1.7.4",
    "connect-mongo": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^6.8.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.0.0",
    "mongodb-memory-server": "^8.12.0",
    "supertest": "^6.3.3",
    "@playwright/test": "^1.55.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 30000,
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "moduleNameMapper": {
      "^/scripts/(.*)$": "<rootDir>/tests/__mocks__/browserModule.js"
    }
  },
  "overrides": {
    "fast-xml-parser": "5.11.1"
  }
}
